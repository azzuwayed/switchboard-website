{
  "name": "switchboard-website",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "check": "pnpm check:format && pnpm check:product && pnpm check:site",
    "check:format": "prettier --check \"*.html\" \"*.js\" \"ar/*.html\" \"*.md\" \"assets/*.md\" \"scripts/*.mjs\" \"style.css\" \"*.json\"",
    "check:site": "node scripts/bump-css-cache.mjs --check && node scripts/check-site.mjs",
    "check:product": "node scripts/sync-product.mjs --check",
    "check:product:source": "node scripts/sync-product.mjs --check --source-parity",
    "format": "prettier --write \"*.html\" \"*.js\" \"ar/*.html\" \"*.md\" \"assets/*.md\" \"scripts/*.mjs\" \"style.css\" \"*.json\"",
    "sync:product": "node scripts/sync-product.mjs"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
